# Environment variables for the Trinity agent container.
# These values are injected at container start.
#
# DO NOT put the bridge pairing token here — the bridge writes it at runtime.
# Keep this file in VCS so operators see what is configurable; runtime-only
# values live in ~/.trinity-bridge/.
TRINITY_AGENT_NAME=Trinity
TRINITY_AGENT_SCOPE=workspace
TRINITY_AGENT_MORPHEUS=false
