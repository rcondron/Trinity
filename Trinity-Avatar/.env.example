# ── Trinity Avatar configuration ─────────────────────────────────────────────
# Copy to .env and fill in what you have. EVERYTHING is optional: with no keys
# at all the platform runs in demo mode (scripted persona, browser TTS,
# procedural motion clips) and every fallback is flagged in the debug overlay.

# ── Voice (ElevenLabs) ────────────────────────────────────────────────────────
# Streaming TTS with character timestamps (drives lip sync) + STT.
# No key → browser SpeechSynthesis + amplitude lip sync fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# PCM output keeps the audio clock exact; leave as-is unless you know better.
ELEVENLABS_OUTPUT_FORMAT=pcm_16000

# ── Conversation brain ────────────────────────────────────────────────────────
# Priority: trinity (if BRIDGE reachable) → hermes (if HERMES_BASE_URL set) → demo.
# Override with BRAIN_BACKEND=trinity|hermes|demo
BRAIN_BACKEND=

# (a) Hermes via any OpenAI-compatible endpoint (vLLM, llama.cpp server, hosted).
#     e.g. vLLM:      HERMES_BASE_URL=http://localhost:8000/v1
#          llama.cpp: HERMES_BASE_URL=http://localhost:8080/v1
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=NousResearch/Hermes-3-Llama-3.1-8B

# (b) Trinity agent via the host Bridge (this repo's Trinity-Bridge, port 4711).
TRINITY_BRIDGE_URL=http://127.0.0.1:4711
TRINITY_BRIDGE_TOKEN=

# ── Services ──────────────────────────────────────────────────────────────────
ORCHESTRATOR_PORT=8790
MOTION_SERVICE_PORT=8791
MOTION_SERVICE_URL=ws://localhost:8791/ws

# Motion backend: auto (ARDY if CUDA GPU + weights present, else clips) | ardy | clips
MOTION_BACKEND=auto
# Where setup_ardy.sh puts the ARDY checkpoint (never vendored in the repo).
ARDY_CHECKPOINT_DIR=./services/motion-service/weights/ardy
MOTION_FPS=30

# ── Web client (Vite; must be prefixed VITE_) ─────────────────────────────────
VITE_ORCHESTRATOR_URL=ws://localhost:8790/session
VITE_MOTION_SERVICE_URL=ws://localhost:8791/ws
# Default avatar path served from apps/web/public (drop your own .vrm there).
VITE_DEFAULT_AVATAR=/avatars/default.vrm
