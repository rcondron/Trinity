# Dependencies
node_modules/
.pnpm-store/

# Builds
dist/
build/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/

# Env & secrets
.env
.env.local

# Downloaded assets & model weights (fetched by scripts/, never vendored)
assets/avatars/*.vrm
assets/avatars/*.glb
apps/web/public/avatars/*.vrm
apps/web/public/avatars/*.glb
# …except our own generated Trinity skin (MIT, built by apps/web/scripts/)
!apps/web/public/avatars/trinity.glb
services/motion-service/weights/

# Editor / OS
.DS_Store
*.log

# Capacitor generated platforms — android/ is committed (ready to build);
# ios/ stays generated (`pnpm add:ios`) since it needs macOS anyway.
apps/mobile/ios/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/src/main/assets/public/
